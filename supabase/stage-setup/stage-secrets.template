# Stage edge function secrets.
# deploy-stage.ps1 copies this file to .env.stage (git-ignored). Fill in
# .env.stage, never this file. Write values as they are, no quotes needed.

# Razorpay TEST mode: Razorpay dashboard -> switch to Test mode -> API Keys.
# rzp_live_ keys are refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when you create the Test mode webhook to
# https://<stage-ref>.supabase.co/functions/v1/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=

# Same Shiprocket account as live.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# The SAME token as live (Shiprocket -> Settings -> API -> Webhooks), so the
# tracking events live forwards to stage are accepted.
SHIPROCKET_WEBHOOK_TOKEN=
# Must stay true on stage: bookings run, but no courier is sent.
SHIPROCKET_SKIP_PICKUP=true

# Zoho mail. The same account as live is fine. The port must be 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: sender address if it is not SMTP_USERNAME.
SMTP_FROM_EMAIL=

# Google Gemini (AI size advice, complete the look, virtual try-on). The same
# key as live is fine. Empty = those three features show an error on stage.
GEMINI_API_KEY=

# Phone sign-in (OTP by SMS) through Twilio Verify. The same values as live.
# These are not function secrets: the script puts them in Supabase Auth
# (Authentication -> Sign In / Providers -> Phone) and turns phone sign-in on.
# Fill in all three or leave all three empty. Each code is a real, paid SMS,
# so test with your own number only.
# Twilio Console -> Account Info -> Account SID (AC...) and Auth Token
TWILIO_VERIFY_ACCOUNT_SID=
TWILIO_VERIFY_AUTH_TOKEN=
# Twilio Console -> Verify -> Services -> Service SID (VA...)
TWILIO_VERIFY_SERVICE_SID=

# Leave empty: the script fills in a random one.
OTP_HASH_SECRET=

# The stage website's address, no trailing slash (for example the Netlify
# address of the stage site). Email buttons and links open it. Empty = they
# open https://allboutiqs.com (live), so fill it in once the stage site exists.
SITE_URL=

# No R2 on stage: shop photos and videos go to stage's own Supabase Storage.
# The script refuses R2_* and MEDIA_BASE_URL values.
