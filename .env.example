# Supabase Storage image resizing (Pro plan feature). Leave unset/false until it is
# enabled on the project, otherwise thumbnails 403 with FeatureNotEnabled.
# VITE_SUPABASE_IMAGE_TRANSFORM="true"

# Shop photos and videos on Cloudflare R2 (src/lib/mediaStorage.ts): the R2
# bucket's public address, no trailing slash. Unset = uploads go to Supabase
# Storage. Set it only after supabase/live-setup/R2_MEDIA.md steps 1-4.
# VITE_MEDIA_BASE_URL="https://media.example.com"

# Shop photos and videos are kept on each device after the first download
# (public/media-sw.js). "off" removes that worker and its files from every
# browser on its next visit - only if it ever misbehaves.
# VITE_MEDIA_CACHE="off"

# Razorpay per-order ceiling for our account (default 500000). Raise only after
# Razorpay raises the account limit.
# VITE_RAZORPAY_MAX_AMOUNT="500000"
